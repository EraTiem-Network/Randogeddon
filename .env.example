# Copy to .env and adjust.

# Which compose files to use.  Server: traefik overlay (Traefik on the same Docker host) or docker-compose.proxy.yml
# (Traefik on another machine, file provider).  Local testing: docker-compose.local.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml

# Archipelago release tag (must match what players' clients/apworlds expect)
AP_VERSION=0.6.8

# --- Addresses -------------------------------------------------------------
# Dashboard: https://<BASE_DOMAIN>   Game servers: <session-id>.<BASE_DOMAIN>:443 (DNS: a wildcard record
# *.<BASE_DOMAIN>). The session IDs are picked when a session is created in the admin panel.
BASE_DOMAIN=randogeddon.eratiem.net

# --- Traefik ---------------------------------------------------------------
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
# The dashboard's certificate (any challenge)
TRAEFIK_CERTRESOLVER=letsencrypt
# The game servers' wildcard certificate *.<BASE_DOMAIN>: a resolver with the DNS challenge (see .docs/OPERATIONS.md)
TRAEFIK_DNS_CERTRESOLVER=letsencrypt-dns

# --- Database ----------------------------------------------------------------
# PostgreSQL (logins, slot passwords): the database's superuser, which only the compose service database-roles and
# the dumps use (it can't log in from the tracker's or the gateway's container). Set a long random value, e.g.
# `openssl rand -base64 32`
POSTGRES_PASSWORD=

# The tracker and the gateway each log in with a database role of its own, never as the superuser: database-roles makes
# both before the tracker starts (the tracker's owns the tables, no superuser), and the tracker gives the gateway's only
# the gateway's rights (the gateway runs Archipelago's Python, which must not reach the accounts). Nothing has to be
# set for that. Unset, the names are the ones below and the passwords are derived: the tracker's from POSTGRES_PASSWORD,
# the gateway's from INTERNAL_TOKEN (a new token gives it a new one at the next start). Set, a password of its own:
# openssl rand -hex 32. A name may not be the superuser's (randogeddon) or the other role's
#TRACKER_DB_USER=randogeddon_tracker
#TRACKER_DB_PASSWORD=
#GATEWAY_DB_USER=randogeddon_gateway
#GATEWAY_DB_PASSWORD=

# Between the tracker and the gateway (the admin panel's control of the game server). A long random value,
# e.g. `openssl rand -hex 32`
INTERNAL_TOKEN=

# --- Game servers ----------------------------------------------------------
# Every slot has its own generated password, checked by the gateway (see the dashboard); each game server's room
# password is made by the gateway at its start, for itself and the tracker only. Remote commands go through the admin
# panel's console (no `!admin`). The hint and release options are set per session, when it is created in the admin
# panel.
# How long a generation may take before it is stopped, in minutes (Archipelago fills on one core: a big multiworld
# takes long)
#GENERATION_MINUTES=60
# How many generations run at once (new sessions' seeds and the spoiler logs' later levels together). 0: as many as
# the machine has cores, less one. Each needs a core and its memory (a big multiworld: gigabytes); fewer need less
#GENERATIONS_AT_ONCE=0
# One MultiServer per running session, each on a free port inside the gateway's container (never published); how many
# run at once is a setting in the Management panel (Users: Game servers at once)

# --- Hosted Minecraft (Minecraft Dig) -------------------------------------------
# true: you, the operator, accept Mojang's EULA (https://aka.ms/MinecraftEULA) for every Minecraft server hosted here
# (the Minecraft Dig slots', reached through Randogeddon Bridge). Without it none runs.
#MINECRAFT_EULA=false
# Between the gateway and the minecraft service only (its servers run third-party mod code, so it never gets
# INTERNAL_TOKEN). A long random value, e.g. `openssl rand -hex 32`, not INTERNAL_TOKEN's; without it none runs
#MINECRAFT_TOKEN=
# How many run at once (each up to 3 GB), and the minecraft service's memory in all
#MINECRAFT_SERVERS=1
#MINECRAFT_MEMORY=3500m

# --- Mail ------------------------------------------------------------------------
# Invitations, address confirmations and deletion warnings go out through this SMTP server; without MAIL_HOST they are
# only written to the tracker's log. MAIL_HOST is the name the server's certificate is for
MAIL_HOST=mail.example.org
# starttls (587) or tls (465)
#MAIL_PORT=587
#MAIL_SECURITY=starttls
MAIL_USER=randogeddon@example.org
MAIL_PASSWORD=
# The sender (default: MAIL_USER)
#MAIL_FROM=randogeddon@example.org
# Connect to this address instead (e.g. the mail server's internal IP, when its public one leads back to this host);
# the certificate is still checked against MAIL_HOST
#MAIL_ADDRESS=10.0.0.5
# The links in the mails (default https://<BASE_DOMAIN>)
#PUBLIC_URL=https://randogeddon.eratiem.net

# --- Two-factor login --------------------------------------------------------
# Encrypts the TOTP secrets: `openssl rand -base64 32`. Empty: a key file in the tracker's state volume (made once). Keep
# it with the database backups: without it every two-factor login has to be set up again
TOTP_KEY=

# --- Single sign-on for Administrators -----------------------------------------
# Administrators log in through Authentik (OpenID Connect); members of OIDC_ADMIN_GROUP are Administrators, and they
# can't log in with a password any more (`randogeddon admins --login <person>` prints a one-time link when Authentik is
# away). Empty OIDC_ISSUER: no login acts as an Administrator, unless ADMIN_PASSWORD_LOGIN (below).
#OIDC_ISSUER=https://auth.example.org/application/o/randogeddon/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_ADMIN_GROUP=randogeddon-administrators
# Authentik's webhooks (a notification rule there, with a webhook transport) when it deletes a person (their account here is deleted too) or changes
# one (their name and address here follow). A long random value, e.g. `openssl rand -hex 32`, the same in Authentik;
# empty: accounts stay, and follow only at the next login
#OIDC_DELETION_TOKEN=
# Where Administrators change their account (name, password, address, second factor); empty: Authentik's user settings
# beside the issuer (https://auth.example.org/if/user/)
#OIDC_ACCOUNT_URL=
# Without single sign-on: true lets Administrators log in with their password and two-factor login (made with
# `randogeddon admins --create`). For local testing and the demo only (docker-compose.local.yml sets it), never for a
# public server. Ignored with OIDC_ISSUER
#ADMIN_PASSWORD_LOGIN=false

# --- Dashboard ---------------------------------------------------------------
TRACKER_TITLE=Randogeddon
# Past sessions are deleted this many days after they finished, unless an admin disabled their auto-deletion; 0: never
SESSION_RETENTION_DAYS=90
# The proxies whose X-Forwarded-For the tracker and the gateway believe for a client's address (the tracker's rate
# limits, the gateway's limit of game clients per address): addresses or CIDR ranges, comma-separated, e.g. Traefik's
# Docker network. Unset: every peer's, which is right only while nothing but Traefik reaches their ports (with
# docker-compose.proxy.yml the ports 8000 and 38281 are published: set Traefik's address)
#TRUSTED_PROXIES=172.16.0.0/12
# CPU level of the native tracker and gateway: x86-64-v3 runs on the server's i7-8700 (and every AVX2 CPU);
# `native` only when building on that machine
#NATIVE_MARCH=x86-64-v3
# native-image's heap while it builds an image (by itself it takes up to three quarters of the machine's memory)
#NATIVE_MAX_HEAP=6g
# A Maven repository that mirrors Maven Central, the Gradle plugin portal and Google, for building the Kotlin images;
# empty: those three directly
#RANDOGEDDON_MAVEN=https://registry.example.org/maven/public/
# Its name, for an init script that finds the login by it (default: mirror)
#RANDOGEDDON_MAVEN_NAME=mirror
# Gradle init script with the mirror's login (default: ~/.gradle/init.gradle.kts)
#GRADLE_INIT_SCRIPT=/home/you/.gradle/init.gradle.kts
