# Copy to .env and adjust.

# Which compose files to use.  Server: traefik overlay.  Local testing: docker-compose.local.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml

# Archipelago release tag (must match what players' clients/apworlds expect)
AP_VERSION=0.6.8

# --- Addresses -------------------------------------------------------------
# Dashboard: https://<BASE_DOMAIN>   Game server: <SESSION_ID>.<BASE_DOMAIN>:443 (see .docs/TODO.md, Conventions)
BASE_DOMAIN=randogeddon.eratiem.net
# The session's ID: a DNS label (lowercase letters, digits, dashes); set a new one for every session
SESSION_ID=example

# --- Traefik ---------------------------------------------------------------
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Database ----------------------------------------------------------------
# PostgreSQL (logins, slot passwords). Set a long random value, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=

# Between the tracker and the gateway (the admin panel's control of the game server). A long random value,
# e.g. `openssl rand -hex 32`
INTERNAL_TOKEN=

# --- Game server -----------------------------------------------------------
# No room password: every slot has its own generated password, checked by the gateway (see the dashboard)
# Password for `!admin` remote server commands (empty = disabled)
AP_ADMIN_PASSWORD=
# auto | enabled | disabled | goal | auto-enabled
AP_RELEASE_MODE=auto
AP_COLLECT_MODE=auto
# enabled | disabled | goal
AP_REMAINING_MODE=goal
AP_COUNTDOWN_MODE=auto

# --- Hints -----------------------------------------------------------------
# Point hints: players earn points by checking locations and buy hints with !hint / !hint_location
AP_POINT_HINTS=true
# A hint costs this % of the player's world's locations in points (0 = free); points per checked location
AP_HINT_COST=10
AP_LOCATION_CHECK_POINTS=1
# Automatic hints: games create hints on their own (e.g. a shop hinting what it sells)
AP_AUTO_HINTS=true
# With both off there are no hints at all (the host can still give some with /hint), and the dashboard hides them

# --- Dashboard ---------------------------------------------------------------
TRACKER_TITLE=Randogeddon
# Past sessions are deleted this many days after they finished, unless an admin disabled their auto-deletion; 0: never
SESSION_RETENTION_DAYS=90
# CPU level of the native tracker and gateway: x86-64-v3 runs on the server's i7-8700 (and every AVX2 CPU);
# `native` only when building on that machine
#NATIVE_MARCH=x86-64-v3
# Gradle init script with the Nexus credentials, used to build the Kotlin images (default: ~/.gradle/init.gradle.kts)
#GRADLE_INIT_SCRIPT=/home/you/.gradle/init.gradle.kts
